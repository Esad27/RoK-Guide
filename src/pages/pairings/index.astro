---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PairingsIndexPage from '../../components/pages/PairingsIndexPage.astro';
import { useTranslations } from '../../i18n';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={`${t('pairings.title')} | ${t('site.name')}`} description={t('pairings.subtitle')} canonical="/pairings">
  <PairingsIndexPage locale={locale} />
</BaseLayout>
