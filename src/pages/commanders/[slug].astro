---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommanderDetailPage from '../../components/pages/CommanderDetailPage.astro';
import { useTranslations } from '../../i18n';
import { getCommander } from '../../data/loaders';
import { commanderSlugs } from '../../lib/paths/commanderPaths';

export function getStaticPaths() {
  return commanderSlugs().map((slug) => ({ params: { slug } }));
}

const locale = 'en' as const;
const t = useTranslations(locale);
const { slug } = Astro.params;
const commander = getCommander(slug);
const title = commander ? `${commander.name} ${t('seo.commanderGuideSuffix')} | ${t('site.name')}` : t('site.name');
const description = commander?.description?.[locale] ?? commander?.description?.en;
---

<BaseLayout locale={locale} title={title} description={description} canonical={`/commanders/${slug}`} image={commander?.image} schemaType="Article" modifiedTime={commander?.verifiedAt}>
  <CommanderDetailPage locale={locale} slug={slug} />
</BaseLayout>
