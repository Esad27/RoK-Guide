---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={`404 | ${t('site.name')}`} alternates={false} noIndex languagePath="/">
  <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 px-4 py-24 text-center">
    <h1 class="font-display text-4xl font-bold text-gold-light">404</h1>
    <p class="text-text-muted">Page not found.</p>
    <a href="/" class="rounded-lg border border-gold/40 px-4 py-2 text-gold-light hover:bg-gold/10">{t('nav.home')}</a>
  </div>
</BaseLayout>
