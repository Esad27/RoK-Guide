---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommandersIndexPage from '../../../components/pages/CommandersIndexPage.astro';
import { useTranslations, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'es' } }];
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={`${t('commanders.title')} | ${t('site.name')}`} description={t('commanders.subtitle')} canonical={`/${locale}/commanders`}>
  <CommandersIndexPage locale={locale} />
</BaseLayout>
