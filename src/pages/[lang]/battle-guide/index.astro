---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BattleGuideIndexPage from '../../../components/pages/BattleGuideIndexPage.astro';
import { useTranslations, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'es' } }];
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={`${t('battleGuide.title')} | ${t('site.name')}`} description={t('battleGuide.subtitle')} canonical={`/${locale}/battle-guide`}>
  <BattleGuideIndexPage locale={locale} />
</BaseLayout>
