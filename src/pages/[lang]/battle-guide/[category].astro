---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideArticlePage from '../../../components/pages/GuideArticlePage.astro';
import { useTranslations, type Locale } from '../../../i18n';
import { battleGuideCategories } from '../../../lib/paths/guidePaths';

export async function getStaticPaths() {
  const langs = ['vi', 'es'];
  const categories = await battleGuideCategories();
  return langs.flatMap((lang) => categories.map((category) => ({ params: { lang, category } })));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const { category } = Astro.params;
const title = `${t(`battleGuide.categories.${category}`)} | ${t('battleGuide.title')} | ${t('site.name')}`;
const description = `${t(`battleGuide.categories.${category}`)}. ${t('battleGuide.subtitle')}`;
---

<BaseLayout locale={locale} title={title} description={description} canonical={`/${locale}/battle-guide/${category}`} schemaType="Article">
  <GuideArticlePage locale={locale} section="battle-guide" category={category} />
</BaseLayout>
