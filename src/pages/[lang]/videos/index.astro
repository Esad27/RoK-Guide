---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VideosPage from '../../../components/pages/VideosPage.astro';
import { useTranslations, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'es' } }];
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={`${t('videos.title')} | ${t('site.name')}`} description={t('videos.subtitle')} canonical={`/${locale}/videos`}>
  <VideosPage locale={locale} />
</BaseLayout>
