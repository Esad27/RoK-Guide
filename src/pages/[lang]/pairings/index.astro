---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PairingsIndexPage from '../../../components/pages/PairingsIndexPage.astro';
import { useTranslations, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'es' } }];
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={`${t('pairings.title')} | ${t('site.name')}`} description={t('pairings.subtitle')} canonical={`/${locale}/pairings`}>
  <PairingsIndexPage locale={locale} />
</BaseLayout>
