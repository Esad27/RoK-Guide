---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FeedbackDonatePage from '../../../components/pages/FeedbackDonatePage.astro';
import { useTranslations, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'es' } }];
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={`${t('feedbackDonate.title')} | ${t('site.name')}`}
  description={t('feedbackDonate.subtitle')}
  canonical={`/${locale}/feedback-donate`}
  languagePath="/feedback-donate"
>
  <FeedbackDonatePage locale={locale} />
</BaseLayout>
