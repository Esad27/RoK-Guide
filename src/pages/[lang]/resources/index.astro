---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResourcesPage from '../../../components/pages/ResourcesPage.astro';
import { useTranslations, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'es' } }];
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={`${t('resources.title')} | ${t('site.name')}`} description={t('resources.subtitle')} canonical={`/${locale}/resources`}>
  <ResourcesPage locale={locale} />
</BaseLayout>
