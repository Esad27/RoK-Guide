---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedbackDonatePage from '../../components/pages/FeedbackDonatePage.astro';
import { useTranslations } from '../../i18n';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={`${t('feedbackDonate.title')} | ${t('site.name')}`}
  description={t('feedbackDonate.subtitle')}
  canonical="/feedback-donate"
  languagePath="/feedback-donate"
>
  <FeedbackDonatePage locale={locale} />
</BaseLayout>
