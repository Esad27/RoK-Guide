---
import type { Channel } from '../data/types';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';

interface Props {
  channel: Channel;
  locale: Locale;
}

const { channel, locale } = Astro.props;
const t = useTranslations(locale);
const description = channel.description?.[locale] ?? channel.description?.en;
const initials = channel.name
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w.charAt(0))
  .join('')
  .toUpperCase();
---

<div class="flex items-center gap-3 rounded-xl border border-line bg-surface p-4">
  {
    channel.logo ? (
      <img src={channel.logo} alt={channel.name} loading="lazy" class="h-16 w-16 shrink-0 rounded-full border border-gold/30 object-cover" />
    ) : (
      <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border border-gold/40 bg-surface-hover font-display text-sm font-semibold text-gold-light">
        {initials}
      </span>
    )
  }
  <div class="min-w-0 flex-1">
    {
      channel.url ? (
        <a href={channel.url} target="_blank" rel="noopener noreferrer" class="truncate font-medium text-text-primary hover:text-gold-light">
          {channel.name}
        </a>
      ) : (
        <span class="truncate font-medium text-text-primary">{channel.name}</span>
      )
    }
    {description && <p class="truncate text-xs text-text-muted">{description}</p>}
  </div>
</div>
