---
import type { Locale } from '../i18n';
import { useTranslations, localizedPath } from '../i18n';
import LanguageSelector from './LanguageSelector.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  languagePath?: string;
}

const { locale, languagePath } = Astro.props;
const t = useTranslations(locale);

const navItems = [
  { href: '/', label: t('nav.home') },
  { href: '/commanders', label: t('nav.commanders') },
  { href: '/pairings', label: t('nav.pairings') },
  { href: '/kvk-guide', label: t('nav.kvkGuide') },
  { href: '/battle-guide', label: t('nav.battleGuide') },
  { href: '/videos', label: t('nav.videos') },
  { href: '/resources', label: t('nav.resources') },
];
const feedbackDonateItem = { href: '/feedback-donate', label: t('nav.feedbackDonate') };
---

<header class="sticky top-0 z-40 border-b border-line bg-bg-primary/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
    <a href={localizedPath(locale, '/')} class="shrink-0 font-display text-lg font-bold tracking-wide text-gold-light">
      {t('site.shortName')}
    </a>

    <nav class="hidden items-center gap-4 xl:flex" aria-label="Primary">
      {
        navItems.map((item) => (
          <a href={localizedPath(locale, item.href)} class="text-sm font-medium text-text-muted transition-colors hover:text-gold-light">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 xl:flex">
      <a
        href={localizedPath(locale, feedbackDonateItem.href)}
        class="rounded-md border border-gold/50 px-3 py-2 text-xs font-semibold text-gold-light transition-colors hover:border-gold hover:bg-gold/10"
      >
        {feedbackDonateItem.label}
      </a>
      <LanguageSelector locale={locale} path={languagePath} />
      <ThemeToggle locale={locale} />
    </div>

    <button
      type="button"
      id="mobile-nav-toggle"
      class="flex items-center justify-center rounded-md border border-line p-2 text-text-primary xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <span aria-hidden="true">☰</span>
    </button>
  </div>

  <div id="mobile-nav" class="hidden flex-col gap-4 border-t border-line px-4 py-4 xl:hidden">
    <nav class="flex flex-col gap-3" aria-label="Primary mobile">
      {
        navItems.map((item) => (
          <a href={localizedPath(locale, item.href)} class="py-1 text-base font-medium text-text-primary">
            {item.label}
          </a>
        ))
      }
      <a href={localizedPath(locale, feedbackDonateItem.href)} class="py-1 font-semibold text-gold-light">
        {feedbackDonateItem.label}
      </a>
    </nav>
    <div class="flex items-center justify-between gap-3 pt-2">
      <LanguageSelector locale={locale} path={languagePath} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const nav = document.getElementById('mobile-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('flex');
      nav.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
