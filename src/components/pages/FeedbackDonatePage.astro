---
import type { Locale } from '../../i18n';
import { useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const walletAddress = 'TGYi7PPov9gCb6q2Zz1sXe361RXANzLbyZ';
const feedbackFormUrl = 'https://forms.gle/jMkHPrpXkB4L97r56';
---

<div class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
  <header class="mx-auto max-w-3xl text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-gold">Legends of Titan</p>
    <h1 class="mt-3 font-display text-3xl font-bold text-text-primary sm:text-4xl">{t('feedbackDonate.title')}</h1>
    <p class="mt-3 text-text-muted">{t('feedbackDonate.subtitle')}</p>
  </header>

  <div class="mt-10 grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
    <section class="flex flex-col rounded-2xl border border-line bg-surface p-6 sm:p-7" aria-labelledby="feedback-title">
      <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-gold/30 bg-gold/10 text-xl text-gold-light" aria-hidden="true">✦</div>
      <h2 id="feedback-title" class="mt-5 font-display text-2xl font-semibold text-text-primary">{t('feedbackDonate.feedbackTitle')}</h2>
      <p class="mt-3 leading-7 text-text-muted">{t('feedbackDonate.feedbackDescription')}</p>
      <div class="mt-auto pt-7">
        <a
          href={feedbackFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center rounded-lg border border-gold/50 bg-gold/10 px-4 py-3 text-center text-sm font-semibold text-gold-light transition-colors hover:border-gold hover:bg-gold/15"
        >
          {t('feedbackDonate.openForm')} ↗
        </a>
      </div>
    </section>

    <section class="rounded-2xl border border-gold/30 bg-surface p-6 shadow-lg sm:p-7" aria-labelledby="donate-title">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 id="donate-title" class="font-display text-2xl font-semibold text-text-primary">{t('feedbackDonate.donateTitle')}</h2>
          <p class="mt-2 max-w-xl leading-7 text-text-muted">{t('feedbackDonate.donateDescription')}</p>
        </div>
        <div class="flex flex-wrap items-center justify-end gap-2 text-right">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">{t('feedbackDonate.supportedAssets')}</p>
          <span class="rounded-full border border-gold/40 bg-gold/10 px-3 py-1 text-xs font-bold text-gold-light">USDT</span>
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-line bg-bg p-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs font-semibold uppercase tracking-wide text-text-muted">{t('feedbackDonate.walletAddress')}</span>
          <span class="text-xs font-semibold text-gold-light">USDT · TRON (TRC20)</span>
        </div>
        <code class="mt-3 block break-all font-mono text-sm font-semibold text-text-primary sm:text-base">{walletAddress}</code>
        <button
          type="button"
          class="mt-4 rounded-md border border-gold/50 px-3 py-2 text-xs font-semibold text-gold-light transition-colors hover:bg-gold/10"
          data-copy-wallet
          data-copy-label={t('feedbackDonate.copyAddress')}
          data-copied-label={t('feedbackDonate.copied')}
          data-wallet-address={walletAddress}
        >
          {t('feedbackDonate.copyAddress')}
        </button>
        <span class="sr-only" aria-live="polite" data-copy-status></span>
      </div>

      <dl class="mt-6 max-w-sm">
        <div class="rounded-lg border border-line p-4">
          <dt class="text-xs uppercase tracking-wide text-text-muted">{t('feedbackDonate.minimumDeposit')}</dt>
          <dd class="mt-1 font-semibold text-text-primary">{t('feedbackDonate.minimumDepositValue')}</dd>
        </div>
      </dl>

      <div class="mt-6 space-y-3 rounded-xl border border-red-500/25 bg-red-500/5 p-4 text-sm">
        <p class="font-semibold text-text-primary">{t('feedbackDonate.warningNft')}</p>
        <p class="font-semibold text-text-primary">{t('feedbackDonate.warningSanctions')}</p>
      </div>
    </section>
  </div>
</div>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-wallet]');
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');

  copyButton?.addEventListener('click', async () => {
    const address = copyButton.dataset.walletAddress ?? '';
    const defaultLabel = copyButton.dataset.copyLabel ?? '';
    const copiedLabel = copyButton.dataset.copiedLabel ?? defaultLabel;
    try {
      await navigator.clipboard.writeText(address);
      copyButton.textContent = copiedLabel;
      if (copyStatus) copyStatus.textContent = copiedLabel;
      window.setTimeout(() => {
        copyButton.textContent = defaultLabel;
      }, 2000);
    } catch {
      if (copyStatus) copyStatus.textContent = address;
    }
  });
</script>
